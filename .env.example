# Postgres connection string
DATABASE_URL=postgres://user:password@127.0.0.1:5432/expenses

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Local SMTP (Mailpit, see docker-compose.yml) — web UI at http://localhost:8027
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
# Production only (leave unset for Mailpit). On a DigitalOcean droplet use
# the provider's port 2525, since 25/465/587 are blocked there.
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM_ADDRESS=noreply@expenses.local
EMAIL_FROM_NAME=Expenses
